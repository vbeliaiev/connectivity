<% content_for :title, @catalog_item.title %>

<div class="w-full">
  <div class="flex flex-col sm:flex-row justify-between items-center mb-5 gap-3">
    <div class="flex flex-wrap gap-2">
      <%= button_tag type: "button", onclick: "history.back()", class: "flex items-center justify-center px-4 py-2.5 border border-gray-300 rounded-md font-medium text-sm text-gray-700 bg-white hover:bg-gray-100 cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-big-left-icon lucide-arrow-big-left mr-1 flex-shrink-0"><path d="M10.793 19.793a.707.707 0 0 0 1.207-.5V16a1 1 0 0 1 1-1h6a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-6a1 1 0 0 1-1-1V4.707a.707.707 0 0 0-1.207-.5l-6.94 6.94a1.207 1.207 0 0 0 0 1.707z"/></svg>
        Retour
      <% end %>
      <%= link_to catalog_path, class: "flex items-center justify-center px-4 py-2.5 rounded-md font-medium text-sm bg-[#8c4e1c] text-white hover:bg-[#d93]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-landmark mr-1 flex-shrink-0"><path d="M10 18v-7"/><path d="M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg>
        Naviguer vers catalogue numérique
      <% end %>
      <%= link_to root_path, class: "flex items-center justify-center px-4 py-2.5 rounded-md font-medium text-sm bg-[#8eb200] text-white hover:bg-[#d93]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house mr-1 flex-shrink-0"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        Naviguer vers l'accueil
      <% end %>
    </div>

    <% if current_user&.moderator? || current_user&.admin? %>
      <div class="flex items-center gap-1">
        <span class="underline text-gray-500">Outils de modération:</span>
        <%= edit_icon_button(edit_catalog_item_path(@catalog_item), label: "(Modifier)") %>
        <%= destroy_icon_button(@catalog_item, label: "(Supprimer)") %>
      </div>
    <% end %>
  </div>

  <div class="p-3 border border-gray-400 rounded-md">
    <h1 class="font-bold text-3xl text-center w-full my-5"><%= @catalog_item.title %></h1>

    <div class="flex flex-col lg:flex-row gap-5" data-controller="image-modal">
      <div class="w-full lg:w-1/3 flex justify-center  items-start">
        <% if @catalog_item.cover.attached? %>
          <figure class="flex flex-col items-center">
            <%= image_tag @catalog_item.cover.variant(resize_to_limit: [600, 600]), class: "border border-gray-400 rounded-md w-[80%] max-w-full h-auto" %>
            <figcaption class="hidden"><%= @catalog_item.title %></figcaption>
            <p class="text-center text-sm text-gray-500 mt-1">Cliquez sur l'image pour zoomer</p>
          </figure>
        <% end %>
      </div>

      <div class="w-full lg:w-2/3 p-4 border border-gray-300 rounded-md">
        <dl class="space-y-3">
          <% if @catalog_item.brand %>
            <div class="flex items-center gap-1">
              <dt class="font-semibold">Marque :</dt>
              <dd class="pt-0.5"><%= link_to @catalog_item.brand.title, catalog_path(filter: { brand_id: @catalog_item.brand.id }), class: "text-blue-600 font-semibold underline" %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.department %>
            <div class="flex items-center gap-1">
              <dt class="font-semibold">Département :</dt>
              <dd class="pt-0.5"><%= link_to @catalog_item.department.name, catalog_path(filter: { department_id: @catalog_item.department.id }), class: "text-blue-600 font-semibold underline" %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.item_category %>
            <div class="flex items-center gap-1">
              <dt class="font-semibold">Catégorie :</dt>
              <dd class="pt-0.5"><%= link_to @catalog_item.item_category.name, catalog_path(filter: { item_category_id: @catalog_item.item_category.id }), class: "text-blue-600 font-semibold underline" %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.model.present? %>
            <div class="flex gap-1">
              <dt class="font-semibold">Modèle :</dt>
              <dd class="pt-0.25"><%= @catalog_item.model %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.production_start_year.present? || @catalog_item.production_end_year.present? %>
            <div class="flex gap-1">
              <dt class="font-semibold">Période de production :</dt>
              <dd><%= [@catalog_item.production_start_year, @catalog_item.production_end_year].compact.join(' - ') %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.country %>
            <div class="flex items-center gap-1">
              <dt class="font-semibold">Pays :</dt>
              <dd><%= link_to @catalog_item.country.name, catalog_path(filter: { country_id: @catalog_item.country.id }), class: "text-blue-600 font-semibold underline" %></dd>
            </div>
            <hr class="border-gray-300">
          <% end %>

          <% if @catalog_item.description.present? %>
            <div>
              <dt class="font-semibold">Description</dt>
              <dd><%= @catalog_item.description %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div data-image-modal-target="modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 hidden" data-action="click->image-modal#closeOnBackdrop">
        <div class="bg-white rounded-lg shadow-lg max-w-3xl w-full p-4 relative">
          <button type="button" class="absolute -top-4 -right-4 w-10 h-10 flex items-center justify-center rounded-full bg-white text-gray-600 hover:text-gray-900 shadow-lg text-2xl leading-none focus:outline-none cursor-pointer" data-action="image-modal#close">
            <span class="sr-only">Close</span>
            &times;
          </button>
          <img data-image-modal-target="image" src="" class="w-full max-h-[80vh] object-contain rounded-md" alt="">
          <p data-image-modal-target="caption" class="text-center text-gray-600 text-sm mt-2 hidden"></p>
        </div>
      </div>
    </div>

    <hr class="border-gray-300 mt-5">
    <h2 class="text-2xl font-bold my-5 text-center underline">Contenu associé</h2>

    <div class="mt-3 p-3 border border-gray-400 rounded-md bg-white">
      <% if @linked_folders.blank? && @linked_pdf_notes.blank? && @linked_video_notes.blank? && @linked_photo_galleries.blank? && @linked_articles.blank? %>
        <p class="text-center text-gray-500">Aucun contenu associé.</p>
      <% else %>
        <%= render 'shared/content_sections',
                   folders: @linked_folders,
                   pdf_notes: @linked_pdf_notes,
                   video_notes: @linked_video_notes,
                   photo_galleries: @linked_photo_galleries,
                   articles: @linked_articles,
                   readonly: true %>
      <% end %>
    </div>
  </div>
</div>
