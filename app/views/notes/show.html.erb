<% content_for :title, "Showing note" %>

<div class="w-full">
  <div class="flex items-center gap-1">
    <%= link_to "Back", (request.referer == root_url || @note.parent.blank?) ? root_path : folder_path(@note.parent), class: "text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= edit_icon_button(edit_note_path(@note)) %>
    <%= destroy_icon_button(@note) %>
  </div>

  <%= render @note %>
</div>
