<% content_for :title, "Notes" %>

<div class="flex flex-col sm:flex-row justify-between items-center">
  <div class="flex space-x-2 my-5 sm:my-0 sm:order-2">
    <%= render 'shared/new_item_dropdown', wrapper_class: "relative inline-block", select_class: "rounded-md pl-3.5 pr-10 py-2.5 bg-blue-700 hover:bg-blue-600 text-white text-sm font-medium cursor-pointer appearance-none" %>
  </div>
  <h1 class="font-bold text-3xl sm:order-1">Latest Notes</h1>
</div>

<div id="notes" class="min-w-full divide-y divide-gray-200 space-y-5">
  <% if @notes.any? %>
    <% @notes.each do |note| %>
      <div class="flex flex-col sm:flex-col justify-between items-start pb-5 sm:pb-0">
        <div class="line-clamp-10">
          <%= render note %>
        </div>
        <div class="w-full sm:w-auto flex flex-col sm:flex-row sm:items-center gap-2 mt-3 mb-3">
          <%= link_to "Show more", note, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-1.5 h-9 flex items-center justify-center bg-gray-100 hover:bg-gray-50 font-medium" %>
          <div class="flex items-center -space-x-1">
            <%= edit_icon_button(edit_note_path(note)) %>
            <%= destroy_icon_button(note) %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex justify-center items-center mb-10">
      <%= paginate @notes, param_name: :notes_page %>
    </div>
  <% else %>
    <p class="text-center my-10">No notes found.</p>
  <% end %>
</div>
