<%# Link to the "Next" page
  - available local variables
    url:           url to the next page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<span class="next">
  <%= link_to_unless current_page.last?, "Suivant".html_safe, url, rel: 'next', remote: remote, class: "flex items-center justify-center h-10 px-3 rounded-md border border-gray-400 hover:bg-[#d93] hover:text-white hover:border-[#d93]" %>
</span>
