<%# Link to the "First" page
  - available local variables
    url:           url to the first page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<span class="first">
  <%= link_to_unless current_page.first?, "Première".html_safe, url, remote: remote, class: "flex items-center justify-center h-10 px-3 rounded-md border border-gray-400 hover:bg-[#d93] hover:text-white hover:border-[#d93]" %>
</span>
