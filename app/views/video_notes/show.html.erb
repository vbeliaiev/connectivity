<% content_for :title, "Showing video" %>

<div class="w-full">
  <h1 class="font-bold text-2xl"><%= @video_note.title %></h1>

  <div class="mt-3">
    <video controls class="max-w-full rounded-md" style="max-height: 70vh;">
      <source src="<%= url_for(@video_note.file) %>" type="<%= @video_note.file.content_type %>">
      Your browser does not support the video tag.
    </video>
  </div>

  <%= link_to "Back", (request.referer == root_url || @video_note.parent.blank?) ? root_path : folder_path(@video_note.parent), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this video", @video_note, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
</div>
