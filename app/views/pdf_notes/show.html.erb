<% content_for :title, "Showing pdf note" %>

<div class="w-full">
  <h1 class="font-bold text-2xl"><%= @pdf_note.title %></h1>

  <%= link_to "Open PDF", url_for(@pdf_note.file), target: "_blank", rel: "noopener", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium mt-3" %>
  <%= link_to "Back", (request.referer == root_url || @pdf_note.parent.blank?) ? root_path : folder_path(@pdf_note.parent), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this pdf note", @pdf_note, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
</div>
