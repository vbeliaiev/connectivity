<% content_for :title, "Showing pdf note" %>

<div class="w-full p-3 border border-gray-400 rounded-md">

  <div class="flex justify-between items-center flex-wrap gap-2">
    <%= render 'shared/breadcrumb', node: @pdf_note %>
    <% if policy(@pdf_note).update? || policy(@pdf_note).destroy? %>
    <div class="flex items-center gap-1" data-controller="catalog-item-link" data-catalog-item-link-base-url-value="<%= catalog_items_path %>">
      <span class="underline text-gray-500">Outils de modération:</span>
      <% if policy(@pdf_note).update? %>
        <%= toggle_visibility_button(@pdf_note, label: (@pdf_note.public_visibility? ? "Rendre privé" : "Rendre public")) %>
        <%= catalog_item_link_button(label: "Associer au catalogue numérique") %>
      <% end %>
      <%= destroy_icon_button(@pdf_note, label: "Supprimer") if policy(@pdf_note).destroy? %>

      <%= render 'shared/catalog_item_link_modal', node: @pdf_note if policy(@pdf_note).update? %>
    </div>
    <% end %>
  </div>

  <h1 class="font-bold text-2xl mt-3"><%= node_title(@pdf_note) %></h1>

  <div class="mt-5 mb-5">
    <%= link_to "Open PDF", url_for(@pdf_note.file), target: "_blank", rel: "noopener", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
