<% content_for :title, "Paramètres - Marques" %>
<% failed = @new_brand if @new_brand&.errors&.any? %>

<h1 class="font-bold text-3xl mb-5">Marques</h1>

<div class="p-3 border border-gray-400 rounded-md mb-5">
  <h2 class="font-semibold text-lg mb-2">Nouvelle marque</h2>
  <%= form_with model: (failed || Brand.new), url: settings_brands_path, scope: :brand, class: "flex flex-col sm:flex-row gap-2" do |form| %>
    <%= form.text_field :title, maxlength: Brand::MAX_TITLE_LENGTH, required: true, placeholder: "Nom de la marque (ex. Peugeot Frères)", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full focus:outline-blue-600", "aria-label": "Nom de la marque" %>
    <%= form.submit "Ajouter la marque", class: "w-full sm:w-auto rounded-md px-3.5 py-2 bg-[#8eb200] hover:bg-[#d93] text-white font-medium cursor-pointer whitespace-nowrap" %>
  <% end %>
  <% if failed %>
    <p class="text-sm text-red-500 mt-1"><%= failed.errors.map(&:message).join('. ') %></p>
  <% end %>
</div>

<div id="brands" class="p-3 border border-gray-400 rounded-md divide-y divide-gray-200">
  <% if @brands.any? %>
    <% @brands.each do |brand| %>
      <div id="<%= dom_id brand %>" class="flex justify-between items-center py-2 gap-2">
        <div>
          <span class="font-semibold"><%= brand.title %></span>
          <span class="text-sm text-gray-500">(<%= pluralize(@items_count_by_brand.fetch(brand.id, 0), "élément", plural: "éléments") %>)</span>
        </div>
        <div class="flex items-center -space-x-1">
          <%= edit_icon_button(edit_settings_brand_path(brand)) %>
          <%= destroy_icon_button(settings_brand_path(brand)) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-center my-10">Aucune marque trouvée.</p>
  <% end %>
</div>
