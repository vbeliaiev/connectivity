<% content_for :title, "Paramètres - Catégories" %>
<%
  # On a failed create, the invalid record is re-rendered with its errors
  # next to the form it came from (top-level form or one category's
  # "add a subcategory" form).
  failed = @new_item_category if @new_item_category&.errors&.any?
  input_class = "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full focus:outline-blue-600"
  submit_class = "w-full sm:w-auto rounded-md px-3.5 py-2 bg-[#8eb200] hover:bg-[#d93] text-white font-medium cursor-pointer whitespace-nowrap"
%>

<h1 class="font-bold text-3xl mb-5">Catégories</h1>

<div class="p-3 border border-gray-400 rounded-md mb-5">
  <h2 class="font-semibold text-lg mb-2">Nouvelle catégorie</h2>
  <%= form_with model: (failed && failed.parent_id.nil? ? failed : ItemCategory.new), url: settings_item_categories_path, scope: :item_category, class: "flex flex-col sm:flex-row gap-2" do |form| %>
    <%= form.text_field :name, maxlength: ItemCategory::MAX_NAME_LENGTH, required: true, placeholder: "Nom de la catégorie (ex. Bois)", class: input_class, "aria-label": "Nom de la catégorie" %>
    <%= form.submit "Ajouter la catégorie", class: submit_class %>
  <% end %>
  <% if failed && failed.parent_id.nil? %>
    <p class="text-sm text-red-500 mt-1"><%= failed.errors.map(&:message).join('. ') %></p>
  <% end %>
</div>

<div id="item_categories" class="space-y-5">
  <% if @item_categories.any? %>
    <% @item_categories.each do |category| %>
      <div id="<%= dom_id category %>" class="p-3 border border-gray-400 rounded-md">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
          <div>
            <h2 class="font-bold text-xl"><%= category.name %></h2>
            <p class="text-sm text-gray-500">
              <%= pluralize(@items_count_by_category.fetch(category.id, 0), "élément", plural: "éléments") %> du catalogue
              &middot; <%= pluralize(category.subcategories.size, "sous-catégorie", plural: "sous-catégories") %>
            </p>
          </div>
          <div class="flex items-center -space-x-1">
            <%= edit_icon_button(edit_settings_item_category_path(category)) %>
            <%= destroy_icon_button(settings_item_category_path(category)) %>
          </div>
        </div>

        <ul class="mt-3 ml-4 pl-3 border-l-2 border-gray-200 divide-y divide-gray-100">
          <% category.subcategories.each do |subcategory| %>
            <li id="<%= dom_id subcategory %>" class="flex justify-between items-center py-1 gap-2">
              <div>
                <span><%= subcategory.name %></span>
                <span class="text-sm text-gray-500">(<%= pluralize(@items_count_by_subcategory.fetch(subcategory.id, 0), "élément", plural: "éléments") %>)</span>
              </div>
              <div class="flex items-center -space-x-1">
                <%= edit_icon_button(edit_settings_item_category_path(subcategory)) %>
                <%= destroy_icon_button(settings_item_category_path(subcategory)) %>
              </div>
            </li>
          <% end %>
          <% if category.subcategories.empty? %>
            <li class="py-1 text-sm text-gray-500">Aucune sous-catégorie.</li>
          <% end %>
        </ul>

        <% failed_here = failed && failed.parent_id == category.id %>
        <%= form_with model: (failed_here ? failed : ItemCategory.new), url: settings_item_categories_path, scope: :item_category, class: "flex flex-col sm:flex-row gap-2 mt-3 ml-4" do |form| %>
          <%= form.hidden_field :parent_id, value: category.id %>
          <%= form.text_field :name, maxlength: ItemCategory::MAX_NAME_LENGTH, required: true, placeholder: "Nouvelle sous-catégorie de « #{category.name} »", class: input_class, "aria-label": "Nom de la sous-catégorie de #{category.name}" %>
          <%= form.submit "Ajouter la sous-catégorie", class: submit_class %>
        <% end %>
        <% if failed_here %>
          <p class="text-sm text-red-500 mt-1 ml-4"><%= failed.errors.map(&:message).join('. ') %></p>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-center my-10">Aucune catégorie trouvée.</p>
  <% end %>
</div>
