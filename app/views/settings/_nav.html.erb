<%# Left-hand menu of the settings area. Add one entry per settings section;
    an entry is highlighted when its controller is the current one. %>
<%= link_to library_path, class: "flex items-center justify-center w-full px-4 py-2.5 mb-3 rounded-md font-medium text-balance lg:text-sm xl:text-base bg-[#8eb200] text-white hover:bg-[#d93]" do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-text mr-1 flex-shrink-0"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 11h8"/><path d="M8 7h6"/></svg>
  <%= t("layouts.sidebar.library_link") %>
<% end %>

<div class="p-3 border border-gray-400 rounded-md mt-2">
  <h1 class="font-bold text-2xl text-center lg:text-left pl-2 mt-1 underline"><%= t("layouts.sidebar.settings_link") %>:</h1>
  <nav id="settings-sections" class="min-w-full space-y-2 lg:mt-5 mb-2">
    <% active = controller_path == "settings/item_categories" %>
    <%= link_to settings_path, class: "flex w-full pr-2 pl-2 pt-2 pb-1 hover:bg-[#d93] hover:text-white hover:rounded-md #{'bg-[#8c4e1c] text-white rounded-md' if active}", "aria-current": (active ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tags mr-1"><path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L17 19"/><path d="M9.586 5.586A2 2 0 0 0 8.172 5H3a1 1 0 0 0-1 1v5.172a2 2 0 0 0 .586 1.414L8.29 18.29a2.426 2.426 0 0 0 3.42 0l3.58-3.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="6.5" cy="9.5" r=".5" fill="currentColor"/></svg>
      Catégories
    <% end %>
    <% active = controller_path == "settings/brands" %>
    <%= link_to settings_brands_path, class: "flex w-full pr-2 pl-2 pt-2 pb-1 hover:bg-[#d93] hover:text-white hover:rounded-md #{'bg-[#8c4e1c] text-white rounded-md' if active}", "aria-current": (active ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-factory mr-1"><path d="M12 16h.01"/><path d="M16 16h.01"/><path d="M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M8 16h.01"/></svg>
      Marques
    <% end %>
    <% active = controller_path == "settings/countries" %>
    <%= link_to settings_countries_path, class: "flex w-full pr-2 pl-2 pt-2 pb-1 hover:bg-[#d93] hover:text-white hover:rounded-md #{'bg-[#8c4e1c] text-white rounded-md' if active}", "aria-current": (active ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe mr-1"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
      Pays
    <% end %>
  </nav>
</div>
