<%# Renders a single folder link tile, used in both the folder show page's
    "Folders:" section and the home page's per-folder preview. %>
<%= link_to folder_path(folder), class: 'flex items-center p-2 rounded-md hover:bg-[#d93] hover:text-white hover:border-black border w-full sm:w-auto' do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-icon lucide-folder mr-1 flex-shrink-0"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
  <span><%= node_title(folder) %></span>
<% end %>
