<%#
  Renders the standard set of "Folders / Documents / Videos / Photo
  Galleries / Pages" sections for a given set of child items. Used by both
  the folder show page (full lists with pagination) and the home page
  (capped previews per root folder with a "+N more" link back to the
  folder's own show page).

  Locals:
    folders, pdf_notes, video_notes, photo_galleries, notes
      - collections (arrays or ActiveRecord::Relation) to render. Any of
        them can be omitted/blank to skip that section entirely.
    paginate
      - when true, renders kaminari pagination controls under each section
        (only makes sense when the collections are Kaminari page objects).
        Defaults to false.
    more_links
      - optional Hash of { section_key => { remaining: Integer, path: String } }
        used to render a "+N more" link under a section when its items were
        capped. section_key is one of :folders, :pdf_notes, :video_notes,
        :photo_galleries, :notes.
    show_destroy_label
      - when true, renders a "(Supprimer)" text label next to destroy icon
        buttons (pdf_notes, video_notes). Defaults to false.
%>
<%
  folders ||= []
  pdf_notes ||= []
  video_notes ||= []
  photo_galleries ||= []
  notes ||= []
  paginate_sections ||= false
  more_links ||= {}
  destroy_label = local_assigns[:show_destroy_label] ? "(Supprimer)" : nil

  sections_before_pdf = folders.present?
  sections_before_video = sections_before_pdf || pdf_notes.present?
  sections_before_gallery = sections_before_video || video_notes.present?
  sections_before_pages = sections_before_gallery || photo_galleries.present?
%>

<% if folders.present? %>
  <div class="mt-3" id="folders-section">
    <h2 class="font-bold text-xl mb-3">Dossiers:</h2>
    <div class="flex flex-wrap gap-3 bg-gray-100 p-3 rounded-md" >
      <% folders.each do |folder| %>
        <%= render 'shared/folder_item', folder: folder %>
      <% end %>
    </div>
    <% if paginate_sections %>
      <div class="flex justify-center items-center">
       <%= paginate folders, param_name: :folders_page %>
      </div>
    <% end %>
    <%= render 'shared/more_link', link: more_links[:folders] %>
  </div>
<% end %>

<% if pdf_notes.present? %>
  <% if sections_before_pdf %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-3" id="pdf_notes-section">
    <h2 class="font-bold text-xl mb-3">Documents:</h2>
    <div class="flex flex-wrap bg-gray-100 p-3 rounded-md" >
      <% pdf_notes.each do |pdf_note| %>
        <div id="<%= dom_id pdf_note %>" class="w-full sm:w-auto my-2  bg-gray-100 mr-5 rounded-md">
          <div class="flex items-center justify-between">
          <%= link_to url_for(pdf_note.file), target: "_blank", rel: "noopener" do %>
            <div class="flex items-center border rounded-md p-2 hover:bg-[#d93] hover:text-white hover:border-black border">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text mr-2 flex-shrink-0"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
              <span><%= pdf_note.title %>&ensp;</span>
              <span class="underline"><%= pdf_note.file.filename.to_s %> </span>
            </div>
          <% end %>
            <%= destroy_icon_button(pdf_note, label: destroy_label) %>
          </div>


        </div>
      <% end %>
    </div>
    <% if paginate_sections %>
      <div class="flex justify-center items-center">
        <%= paginate pdf_notes, param_name: :pdf_notes_page %>
      </div>
    <% end %>
    <%= render 'shared/more_link', link: more_links[:pdf_notes] %>
  </div>
<% end %>

<% if video_notes.present? %>
  <% if sections_before_video %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-3" id="video_notes-section" data-controller="video-modal">
    <h2 class="font-bold text-xl mb-3">Vidéos:</h2>
    <div class="flex flex-wrap gap-3 bg-gray-100 p-3 rounded-md">
      <% video_notes.each do |video_note| %>
        <div id="<%= dom_id video_note %>" class="flex items-center">
          <button type="button"
                  class="flex items-center p-2 rounded-md hover:bg-[#d93] hover:text-white hover:border-black border cursor-pointer"
                  data-action="video-modal#open"
                  data-url="<%= url_for(video_note.file) %>"
                  data-type="<%= video_note.file.content_type %>"
                  data-title="<%= video_note.title %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera mr-1 flex-shrink-0"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
            <span><%= video_note.title %></span>
          </button>
          <%= destroy_icon_button(video_note, label: destroy_label) %>
        </div>
      <% end %>
    </div>
    <% if paginate_sections %>
      <div class="flex justify-center items-center">
        <%= paginate video_notes, param_name: :video_notes_page %>
      </div>
    <% end %>
    <%= render 'shared/more_link', link: more_links[:video_notes] %>

    <div data-video-modal-target="modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 hidden" data-action="click->video-modal#closeOnBackdrop">
      <div class="bg-white rounded-lg shadow-lg max-w-3xl w-full p-4 relative">
        <div class="flex justify-between items-center mb-2">
          <h3 class="text-lg font-semibold" data-video-modal-target="title"></h3>
          <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none text-5xl leading-none -mt-4 cursor-pointer" data-action="video-modal#close">
            <span class="sr-only">Close</span>
            &times;
          </button>
        </div>
        <video controls data-video-modal-target="player" class="w-full rounded-md" style="max-height: 70vh;">
          <source data-video-modal-target="source" src="" type="">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
<% end %>

<% if photo_galleries.present? %>
  <% if sections_before_gallery %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-3" id="photo_galleries-section">
    <h2 class="font-bold text-xl mb-3">Galeries photos:</h2>
    <div class="flex flex-wrap gap-3 bg-gray-100 p-3 rounded-md">
      <% photo_galleries.each do |gallery| %>
        <%= link_to photo_gallery_path(gallery), id: dom_id(gallery), class: "flex items-center p-2 rounded-md hover:bg-[#d93] hover:text-white hover:border-black border w-full sm:w-auto" do %>
          <% if (cover = gallery.cover_item) && cover.image.attached? %>
            <%= image_tag cover.image.variant(resize_to_fill: [64, 64]), class: "w-16 h-16 object-cover rounded-md mr-3 flex-shrink-0" %>
          <% else %>
            <span class="flex items-center justify-center w-16 h-16 rounded-md bg-gray-100 mr-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image text-gray-500"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </span>
          <% end %>
          <span><%= gallery.title %></span>
        <% end %>
      <% end %>
    </div>
    <% if paginate_sections %>
      <div class="flex justify-center items-center">
        <%= paginate photo_galleries, param_name: :photo_galleries_page %>
      </div>
    <% end %>
    <%= render 'shared/more_link', link: more_links[:photo_galleries] %>
  </div>
<% end %>

<% if notes.present? %>
  <% if sections_before_pages %>
    <hr class="text-gray-200 mt-5">
  <% end %>

  <div class="mt-3" id="notes-section">
    <h2 class="font-bold text-xl mb-3">Pages:</h2>
    <div class="flex flex-wrap gap-3 bg-gray-100 p-3 rounded-md">
      <% notes.each do |note| %>
        <%= link_to note_path(note), id: dom_id(note), class: "flex items-center p-2 rounded-md hover:bg-[#d93] hover:text-white hover:border-black border w-full sm:w-auto" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-text mr-1 flex-shrink-0"><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9.5 8h5"/><path d="M9.5 12H16"/><path d="M9.5 16H14"/></svg>
          <span><%= note.title %></span>
        <% end %>
      <% end %>
    </div>
    <% if paginate_sections %>
      <div class="flex justify-center items-center">
        <%= paginate notes, param_name: :notes_page %>
      </div>
    <% end %>
    <%= render 'shared/more_link', link: more_links[:notes] %>
  </div>
<% end %>
