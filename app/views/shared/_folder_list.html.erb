
<% if @sidebar_folders.present? %>
  <% @sidebar_folders.each do |folder| %>
    <% active = (params[:controller] == "folders") && (params[:id]&.to_i == folder.id) %>
    <%= link_to folder_path(folder), class: "flex w-full pr-2 pl-2 pt-2 pb-1 hover:bg-[#d93] hover:text-white hover:rounded-md #{'bg-[#8c4e1c] text-white rounded-md' if active}" do %>
      <div class="flex w-full flex-col sm:flex-row justify-between items-center">
        <div id="<%= dom_id folder %>" class="w-full mb-1">
          <div class="flex">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-icon lucide-folder mr-1"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
              <%= folder.title %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p class="text-center my-10">No folders found.</p>
<% end %>

<div class="flex">
  <%= paginate @sidebar_folders, param_name: :folders_page %>
</div>
