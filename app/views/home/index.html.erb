<% if @query.present? %>
  <div class="flex flex-col sm:flex-row justify-between items-center">
    <h1 class="font-bold text-3xl">Search results for &ldquo;<%= @query %>&rdquo;</h1>
  </div>

  <% if @folders.blank? && @notes.blank? && @pdf_notes.blank? && @video_notes.blank? && @photo_galleries.blank? %>
    <p class="text-center my-10">Aucun résultat trouvé.</p>
  <% else %>
    <div class="mt-5 p-3 border border-gray-400 rounded-md">
      <%= render 'shared/content_sections',
                 folders: @folders,
                 pdf_notes: @pdf_notes,
                 video_notes: @video_notes,
                 photo_galleries: @photo_galleries,
                 notes: @notes,
                 show_destroy_label: true %>
    </div>
  <% end %>
<% else %>
  <div class="flex flex-col sm:flex-row justify-between items-center">
    <div class="flex space-x-2 my-5 sm:my-0 sm:order-2">
      <%= render 'shared/new_item_dropdown', wrapper_class: "relative inline-block", select_class: "rounded-md pl-9 pr-10 py-2.5 bg-[#8eb200] hover:bg-[#d93] text-white text-base font-medium cursor-pointer appearance-none" %>
    </div>
    <h1 class="font-bold text-3xl sm:order-1">Page d'accueil des adhérents AICMC</h1>
  </div>

  <% if @root_folders.present? %>
    <% @root_folders.each do |folder| %>
      <div class="mt-5 p-3 border border-gray-400 rounded-md">
        <%= link_to folder_path(folder), class: "inline-flex items-center px-3.5 py-2.5 rounded-md font-medium bg-[#8c4e1c] text-white hover:bg-[#d93]" do %>
          <% if folder.generic? %>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star mr-2 flex-shrink-0"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
          <% else %>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-icon lucide-folder mr-2 flex-shrink-0"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
          <% end %>
          <h2 class="font-bold text-lg"><%= folder.title %></h2>
        <% end %>

        <%
          child_folders = folder.child_folders_preview
          child_pdf_notes = folder.child_pdf_notes_preview
          child_video_notes = folder.child_video_notes_preview
          child_photo_galleries = folder.child_photo_galleries_preview
          child_notes = folder.child_notes_preview
        %>

        <% if child_folders.items.blank? && child_pdf_notes.items.blank? && child_video_notes.items.blank? && child_photo_galleries.items.blank? && child_notes.items.blank? %>
          <p class="teext-gray-500 mt-2">Ce dossier est vide.</p>
        <% else %>
          <%= render 'shared/content_sections',
                     folders: child_folders.items,
                     pdf_notes: child_pdf_notes.items,
                     video_notes: child_video_notes.items,
                     photo_galleries: child_photo_galleries.items,
                     notes: child_notes.items,
                     more_links: {
                       folders: (child_folders.more? ? { remaining: child_folders.remaining_count, path: folder_path(folder, anchor: 'folders-section') } : nil),
                       pdf_notes: (child_pdf_notes.more? ? { remaining: child_pdf_notes.remaining_count, path: folder_path(folder, anchor: 'pdf_notes-section') } : nil),
                       video_notes: (child_video_notes.more? ? { remaining: child_video_notes.remaining_count, path: folder_path(folder, anchor: 'video_notes-section') } : nil),
                       photo_galleries: (child_photo_galleries.more? ? { remaining: child_photo_galleries.remaining_count, path: folder_path(folder, anchor: 'photo_galleries-section') } : nil),
                       notes: (child_notes.more? ? { remaining: child_notes.remaining_count, path: folder_path(folder, anchor: 'notes-section') } : nil)
                     },
                     show_destroy_label: true %>
        <% end %>
      </div>
    <% end %>

    <div class="flex<%= ' mt-5' if @root_folders.total_pages > 1 %>">
      <%= paginate @root_folders, param_name: :folders_page %>
    </div>
  <% else %>
    <p class="text-center my-10">Aucun dossier trouvé.</p>
  <% end %>
<% end %>
