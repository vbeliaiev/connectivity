<div id="privacy-policy-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
  <div class="bg-white rounded-lg shadow-lg max-w-lg w-full p-6 relative">
    <button type="button" class="absolute top-2 right-2 text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('privacy-policy-modal').classList.add('hidden')">
      <span class="sr-only"><%= t("devise.registrations._privacy_policy_modal.close") %></span>
      &times;
    </button>
    <h3 class="text-lg font-semibold mb-2"><%= t("devise.registrations._privacy_policy_modal.heading") %></h3>
    <div class="text-sm text-gray-700 space-y-2">
      <%= t("devise.registrations._privacy_policy_modal.body_html") %>
    </div>
  </div>
</div>
