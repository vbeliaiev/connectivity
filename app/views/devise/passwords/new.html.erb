<div class="w-full max-w-md mx-auto border border-gray-400 rounded-md p-8">
  <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
    <%= t("devise.passwords.new.heading") %>
  </h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, t("devise.passwords.new.email_label"), class: "sr-only" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full px-3 py-2 border border-gray-300 rounded-md text-sm", placeholder: t("devise.passwords.new.email_placeholder") %>
    </div>

    <div>
      <%= f.submit t("devise.passwords.new.submit"), class: "group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-[#8c4e1c] hover:bg-[#d93] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8c4e1c] cursor-pointer" %>
    </div>
  <% end %>

  <div class="text-sm text-center mt-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
