<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="bg-red-50 border border-red-400 text-red-700 rounded-md p-4 mb-4">
    <h2 class="font-medium">
      <%= t("devise.shared.error_messages.heading", count: resource.errors.count) %>
    </h2>
    <ul class="list-disc list-inside text-sm mt-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
