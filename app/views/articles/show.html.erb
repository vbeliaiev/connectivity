<% content_for :title, "Showing article" %>

<div class="w-full">
  <%= render 'shared/breadcrumb', node: @article %>

  <% if policy(@article).edit? %>
  <div class="flex items-center gap-1 mt-3" data-controller="catalog-item-link" data-catalog-item-link-base-url-value="<%= catalog_items_path %>">
    <span class="underline text-gray-500">Outils d'administration:</span>
    <%= edit_icon_button(edit_article_path(@article), label: "(Modifier)") %>
    <%= destroy_icon_button(@article, label: "(Supprimer)") %>
    <%= catalog_item_link_button(label: "Associer au catalogue numérique") %>

    <%= render 'shared/catalog_item_link_modal', node: @article %>
  </div>
  <% end %>

  <%= render @article %>
</div>
