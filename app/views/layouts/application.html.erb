<!DOCTYPE html>
<html>
  <head>
    <title>Connectivity</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= favicon_link_tag 'logo-aicmc.jpg' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

    <main class="container mx-auto mt-2 px-5 flex flex-col w-full">
      <%= render '/layouts/user_actions_header' %>
        <% if notice.present? %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block" id="notice"><%= alert %></p>
        <% end %>

      <% if @sidebar_folders %>
        <div class="flex sm:flex-row flex-col w-full">
          <div class="sm:block sm:w-1/4 pr-7">
            <h1 class="font-bold text-2xl text-center sm:text-left">Folders</h1>
            <div id="folders" class="min-w-full divide-y divide-gray-200 space-y-2 sm:my-5">
              <%= render 'shared/folder_list' %>
            </div>
          </div>
          <div class="w-full sm:w-3/4">
            <%= yield %>
          </div>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    </main>
  </body>
</html>

