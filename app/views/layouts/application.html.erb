<!DOCTYPE html>
<html>
  <head>
    <title>Connectivity</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= favicon_link_tag 'logo-aicmc.jpg' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

    <main class="container mx-auto mt-2 px-5 flex flex-col w-full">
      <%= render '/layouts/user_actions_header' %>
        <% if notice.present? %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block" id="notice"><%= alert %></p>
        <% end %>

      <% if @sidebar_folders %>
        <%= form_with url: root_path, method: :get, local: true, class: "w-full mb-5" do %>
          <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden shadow-sm">
            <%= text_field_tag :query, params[:query], placeholder: "Search notes...", class: "w-2/3 sm:flex-grow px-4 py-2 text-gray-700 focus:outline-none" %>
            <%= submit_tag "Search", class: "w-1/3 sm:w-auto bg-blue-700 text-white px-4 py-2 hover:bg-blue-800" %>
          </div>
        <% end %>

        <div class="flex sm:flex-row flex-col w-full">
          <div class="sm:block sm:w-1/4 pr-7">
            <%= link_to root_path, class: "inline-flex items-center px-3.5 py-2.5 mb-3 rounded-md font-medium bg-[#8eb200] text-white hover:bg-[#d93]" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house mr-1 flex-shrink-0"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Home
            <% end %>
            <h1 class="font-bold text-2xl text-center sm:text-left">Folders</h1>
            <div id="folders" class="min-w-full divide-y divide-gray-200 space-y-2 sm:my-5">
              <%= render 'shared/folder_list' %>
            </div>
          </div>
          <div class="w-full sm:w-3/4">
            <%= yield %>
          </div>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    </main>
  </body>
</html>

