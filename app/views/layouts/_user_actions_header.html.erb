<header class="flex flex-col w-full sm:py-2">
  <% if user_signed_in? %>
    <div class="container flex justify-center sm:justify-end">
      <%= link_to "Mon compte", edit_user_registration_path, class: "sm:text-base text-sm block font-medium text-gray-500 hover:text-gray-900 pr-3" %>
      <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "sm:text-base block text-sm font-medium text-gray-500 hover:text-gray-900" %>
    </div>
  <% else %>
    <div class="container flex justify-center sm:justify-end">
      <%= link_to "Se connecter", new_user_session_path, class: "sm:text-base text-sm block font-medium text-gray-500 hover:text-gray-900" %>
    </div>
  <% end %>

  <div class="flex items-center mt-0 gap-4">
    <%= link_to root_path, class: "flex-shrink-0" do %>
      <%= image_tag 'logo-aicmc.jpg', class: 'h-[134px] w-[134px] object-contain rounded' %>
    <% end %>
    <div class="flex flex-col">
      <span class="font-bold text-gray-800 text-xl sm:text-xl">Association internationale des collectionneurs de moulins à café</span>
      <span class="text-gray-800 text-sm sm:text-base mt-1 italic">Site permettant de se plonger dans l'histoire des moulins à café. Fabrication artisanale et industrielle du 17ème siècle à nos jours. Venez découvrir les moulins fabriqués sur la "planète café".</span>
    </div>
  </div>
</header>
