<header class="flex flex-col w-full sm:py-2">
  <div class="container flex justify-center sm:justify-end items-center">
    <% if user_signed_in? %>
      <%= link_to t("layouts.header.my_account"), edit_user_registration_path, class: "sm:text-base text-sm block font-medium text-gray-500 hover:text-gray-900 pr-3" %>
      <%= button_to t("layouts.header.sign_out"), destroy_user_session_path, method: :delete, class: "sm:text-base block text-sm font-medium text-gray-500 hover:text-gray-900" %>
    <% else %>
      <%= link_to t("layouts.header.sign_in"), new_user_session_path, class: "sm:text-base text-sm block font-medium text-gray-500 hover:text-gray-900" %>
    <% end %>
  </div>

  <div class="flex items-center -mt-2 gap-4">
    <%= link_to root_path, class: "flex-shrink-0" do %>
      <%= image_tag 'logo-aicmc.jpg', class: 'h-[134px] w-[134px] object-contain rounded' %>
    <% end %>
    <div class="flex flex-col">
      <span class="font-bold text-gray-800 text-xl sm:text-xl"><%= t("layouts.header.org_name") %></span>
      <span class="text-gray-800 text-sm sm:text-base mt-1 italic"><%= t("layouts.header.org_tagline") %></span>
    </div>
  </div>
</header>
