<!DOCTYPE html>
<html>
  <head>
    <title><%= t("layouts.application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= favicon_link_tag 'logo-aicmc.jpg' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <main class="container mx-auto mt-2 px-5 flex flex-col">

      <%= render '/layouts/user_actions_header' %>
      <% if notice %>
        <div class="mb-4 p-2 bg-green-100 text-green-800 rounded text-center"> <%= notice %> </div>
      <% end %>
      <% if alert && !devise_controller? %>
        <div class="mb-4 p-2 bg-red-100 text-red-800 rounded text-center"> <%= alert %> </div>
      <% end %>
      <%= yield %>

      <footer class="w-full text-center text-sm font-semibold text-gray-500 py-4">
        &copy; AICMC <%= Date.current.year %> <%= t("layouts.footer.rights") %>
        &middot;
        <%= link_to t("layouts.footer.mentions_legales"), mentions_legales_path, class: "hover:underline" %>
        &middot;
        <%= link_to t("layouts.footer.politique_confidentialite"), politique_confidentialite_path, class: "hover:underline" %>
        <div class="mt-2"><%= render "layouts/language_switcher" %></div>
      </footer>
    </main>
  </body>
</html>
