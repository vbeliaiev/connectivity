<!DOCTYPE html>
<html>
  <head>
    <title><%= t("layouts.catalog.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= favicon_link_tag 'logo-aicmc.jpg' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

    <main class="container mx-auto mt-2 px-5 flex flex-col w-full">
      <%= render '/layouts/user_actions_header' %>
      <%= render '/layouts/hero_carousel' if show_hero_carousel? %>
        <% if notice.present? %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block" id="notice"><%= alert %></p>
        <% end %>

      <%= yield %>

      <%= render "layouts/footer", sidebar_offset: catalog_filters_sidebar? %>
    </main>
  </body>
</html>
