<% content_for :title, "Showing folder" %>

<div class="w-full">
  <%= render 'shared/breadcrumb', node: @folder %>

  <div class='flex flex-col sm:flex-row justify-between mt-3'>
    <div class='flex gap-2 flex-col sm:flex-row'>
      <div class="flex items-center gap-1">
        <span class="underline text-gray-500">Outils d'administration:</span>
        <%= edit_icon_button(edit_folder_path(@folder), label: "(Modifier)") %>
        <%= destroy_icon_button(@folder, label: "(Supprimer)") %>
      </div>
    </div>
    <div class='flex flex-row'>
      <%= render 'shared/new_item_dropdown', parent_id: @folder.id %>
    </div>
  </div>

  <div class="mt-5 p-3 border border-gray-400 rounded-md">
    <%= render 'folder_content' %>
  </div>
</div>
