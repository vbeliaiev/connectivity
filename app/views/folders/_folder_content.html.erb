<%
  sections_before_pdf = @child_folders.present?
  sections_before_video = sections_before_pdf || @child_pdf_notes.present?
  sections_before_gallery = sections_before_video || @child_video_notes.present?
  sections_before_pages = sections_before_gallery || @child_photo_galleries.present?
%>

<% if @child_folders.present? %>
  <hr class="text-gray-200 mt-5">
  <div class="mt-5">
    <h2 class="font-bold text-xl mb-3">Folders:</h2>
    <% @child_folders.each do |folder| %>
      <div class="flex flex-col sm:flex-row justify-between items-center">
        <div class="w-full sm:w-auto mb-2">
          <div>
            <%= link_to folder_path(folder), class: 'flex' do %>
              <% if folder.generic? %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star mr-1"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-icon lucide-folder mr-1"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
              <% end %>
              <%= folder.title %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <div class="flex justify-center items-center">
     <%= paginate @child_folders, param_name: :folders_page %>
    </div>
  </div>
<% end %>

<% if @child_pdf_notes.present? %>
  <% if sections_before_pdf %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-5">
    <h2 class="font-bold text-xl mb-3">Documents (pdf):</h2>
    <% @child_pdf_notes.each_with_index do |pdf_note, index| %>
      <% if index > 0 %>
        <hr class="text-gray-200 mb-5">
      <% end %>
      <div id="<%= dom_id pdf_note %>" class="w-full sm:w-auto my-5 space-y-1">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text mr-2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            <span><%= pdf_note.title %></span>
          </div>
          <%= destroy_icon_button(pdf_note) %>
        </div>
        <%= link_to pdf_note.file.filename.to_s, url_for(pdf_note.file), target: "_blank", rel: "noopener", class: "text-black underline" %>
      </div>
    <% end %>
    <div class="flex justify-center items-center">
      <%= paginate @child_pdf_notes, param_name: :pdf_notes_page %>
    </div>
  </div>
<% end %>

<% if @child_video_notes.present? %>
  <% if sections_before_video %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-5" data-controller="video-modal">
    <h2 class="font-bold text-xl mb-3">Videos:</h2>
    <% @child_video_notes.each_with_index do |video_note, index| %>
      <% if index > 0 %>
        <hr class="text-gray-200 mb-5">
      <% end %>
      <div id="<%= dom_id video_note %>" class="w-full sm:w-auto my-5 flex items-center justify-between">
        <button type="button"
                class="flex items-center text-left cursor-pointer group"
                data-action="video-modal#open"
                data-url="<%= url_for(video_note.file) %>"
                data-type="<%= video_note.file.content_type %>"
                data-title="<%= video_note.title %>">
          <span class="flex items-center justify-center w-16 h-16 rounded-md bg-gray-100 group-hover:bg-gray-200 mr-3 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera text-gray-500"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </span>
          <span class="text-black underline"><%= video_note.title %></span>
        </button>
        <%= destroy_icon_button(video_note) %>
      </div>
    <% end %>
    <div class="flex justify-center items-center">
      <%= paginate @child_video_notes, param_name: :video_notes_page %>
    </div>

    <div data-video-modal-target="modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 hidden" data-action="click->video-modal#closeOnBackdrop">
      <div class="bg-white rounded-lg shadow-lg max-w-3xl w-full p-4 relative">
        <div class="flex justify-between items-center mb-2">
          <h3 class="text-lg font-semibold" data-video-modal-target="title"></h3>
          <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none text-5xl leading-none -mt-4 cursor-pointer" data-action="video-modal#close">
            <span class="sr-only">Close</span>
            &times;
          </button>
        </div>
        <video controls data-video-modal-target="player" class="w-full rounded-md" style="max-height: 70vh;">
          <source data-video-modal-target="source" src="" type="">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
<% end %>

<% if @child_photo_galleries.present? %>
  <% if sections_before_gallery %>
    <hr class="text-gray-200 mt-5">
  <% end %>
  <div class="mt-5">
    <h2 class="font-bold text-xl mb-3">Photo Galleries:</h2>
    <% @child_photo_galleries.each_with_index do |gallery, index| %>
      <% if index > 0 %>
        <hr class="text-gray-200 mb-5">
      <% end %>
      <div id="<%= dom_id gallery %>" class="w-full sm:w-auto my-5">
        <%= link_to photo_gallery_path(gallery), class: "flex items-center" do %>
          <% if (cover = gallery.cover_item) && cover.image.attached? %>
            <%= image_tag cover.image.variant(resize_to_fill: [64, 64]), class: "w-16 h-16 object-cover rounded-md mr-3 flex-shrink-0" %>
          <% else %>
            <span class="flex items-center justify-center w-16 h-16 rounded-md bg-gray-100 mr-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image text-gray-500"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </span>
          <% end %>
          <span class="text-black underline"><%= gallery.title %></span>
        <% end %>
      </div>
    <% end %>
    <div class="flex justify-center items-center">
      <%= paginate @child_photo_galleries, param_name: :photo_galleries_page %>
    </div>
  </div>
<% end %>

<% if @child_notes.present? %>
  <% if sections_before_pages %>
    <hr class="text-gray-200 mt-5">
  <% end %>

  <div class="mt-5">
    <h2 class="font-bold text-xl mb-3">Pages:</h2>
    <% @child_notes.each_with_index do |note, index| %>
      <% if index > 0 %>
        <hr class="text-gray-200 mb-5">
      <% end %>
      <div id="<%= dom_id note %>" class="w-full sm:w-auto my-5 space-y-5">
        <h3 class="font-bold text-lg"><%= note.title %></h3>
        <div class="line-clamp-10">
          <%= note.page %>
        </div>
        <%= link_to "Check Details", note_path(note), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      </div>
    <% end %>
    <div class="flex justify-center items-center">
      <%= paginate @child_notes, param_name: :notes_page %>
    </div>
  </div>
<% end %>
