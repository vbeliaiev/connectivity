<%= form_with url: catalog_path, method: :get, local: true do %>
  <div class="w-full mt-3 sm:mt-0 mb-5">
    <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden shadow-sm">
      <%= text_field_tag :query, params[:query], placeholder: "Rechercher dans le catalogue…", class: "w-2/3 sm:flex-grow px-4 py-2 text-gray-700 focus:outline-none" %>
      <%= submit_tag "Rechercher", class: "w-1/3 sm:w-auto bg-[#8c4e1c] text-white px-4 py-2 hover:bg-[#d93] cursor-pointer" %>
    </div>
  </div>

  <div class="flex lg:flex-row flex-col w-full">
    <div class="lg:block lg:w-1/4 lg:pr-7 mb-3 lg:mb-0">
      <%= link_to root_path, class: "flex items-center justify-center w-full px-4 py-2.5 mb-3 rounded-md font-medium text-balance lg:text-sm xl:text-base bg-[#8eb200] text-white hover:bg-[#d93]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house mr-1 flex-shrink-0"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        Naviguer vers l'accueil
      <% end %>

      <%= link_to catalog_path, class: "flex items-center justify-center w-full px-4 py-2.5 mb-3 border border-gray-300 rounded-md font-medium text-balance lg:text-sm xl:text-base text-gray-700 bg-white hover:bg-[#d93]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw mr-1 flex-shrink-0"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
        Effacer les filtres
      <% end %>

      <div class="p-3 border border-gray-400 rounded-md mt-2">
        <h1 class="font-bold text-2xl text-center lg:text-left mt-1 underline">Filtres:</h1>
        <div class="space-y-3 mt-3">
          <div>
            <%= label_tag "filter_brand_id", "Marque", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "filter[brand_id]", options_for_select(Brand.all.pluck(:title, :id), params.dig(:filter, :brand_id)), include_blank: "Choisir une marque", class: "w-full border border-gray-300 rounded-md px-2 py-1.5 text-gray-700" %>
          </div>

          <div>
            <%= label_tag "filter_item_category_id", "Catégorie", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "filter[item_category_id]", options_for_select(ItemCategory.all.pluck(:name, :id), params.dig(:filter, :item_category_id)), include_blank: "Choisir une catégorie", class: "w-full border border-gray-300 rounded-md px-2 py-1.5 text-gray-700" %>
          </div>

          <div>
            <%= label_tag "filter_production_start_year", "Année de début de production", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= number_field_tag "filter[production_start_year]", params.dig(:filter, :production_start_year), min: 1, placeholder: "Choisir une année de début", class: "w-full border border-gray-300 rounded-md px-2 py-1.5 text-gray-700" %>
          </div>

          <div>
            <%= label_tag "filter_production_end_year", "Année de fin de production", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= number_field_tag "filter[production_end_year]", params.dig(:filter, :production_end_year), min: 1, placeholder: "Choisir une année de fin", class: "w-full border border-gray-300 rounded-md px-2 py-1.5 text-gray-700" %>
          </div>

          <div>
            <%= label_tag "filter_country_id", "Pays", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "filter[country_id]", options_for_select(Country.all.pluck(:name, :id), params.dig(:filter, :country_id)), include_blank: "Choisir un pays", class: "w-full border border-gray-300 rounded-md px-2 py-1.5 text-gray-700" %>
          </div>

          <%= submit_tag "Rechercher", class: "w-full bg-[#8c4e1c] text-white px-4 py-2 rounded-md font-medium hover:bg-[#d93] cursor-pointer" %>
        </div>
      </div>
    </div>

    <div class="w-full lg:w-3/4">
      <div class="flex flex-col sm:flex-row justify-between items-center mb-3">
        <% if current_user&.admin? || current_user&.moderator? %>
          <div class="flex space-x-2 my-5 sm:my-0 sm:order-2">
            <%= link_to new_catalog_item_path, class: "relative inline-flex items-center rounded-md pl-9 pr-5 py-2.5 bg-[#8eb200] hover:bg-[#d93] text-white text-base font-medium cursor-pointer" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-plus pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-white">
                <rect width="18" height="18" x="3" y="3" rx="2"/>
                <path d="M8 12h8"/>
                <path d="M12 8v8"/>
              </svg>
              Ajouter au catalogue
            <% end %>
          </div>
        <% end %>
        <h1 class="font-bold text-3xl sm:order-1 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-landmark mr-2 flex-shrink-0"><path d="M10 18v-7"/><path d="M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg>
          Catalogue numérique des adhérents AICMC
        </h1>
      </div>

      <div class="p-3 border border-gray-400 rounded-md">
        <% if @catalog_items.present? %>
          <ul class="min-w-full divide-y divide-gray-200 border-b border-gray-200">
            <% @catalog_items.each do |catalog_item| %>
              <li class="py-1">
                <%= link_to catalog_item_path(catalog_item), class: "flex items-center gap-3 px-2 py-2 rounded-md hover:bg-[#d93] hover:text-white" do %>
                  <% if catalog_item.cover.attached? %>
                    <%= image_tag catalog_item.cover.variant(resize_to_fill: [48, 48]), class: "w-12 h-12 object-cover rounded-md border border-gray-300 flex-shrink-0" %>
                  <% else %>
                    <div class="w-12 h-12 rounded-md border border-gray-300 bg-gray-100 flex-shrink-0"></div>
                  <% end %>
                  <span><%= catalog_item.title %></span>
                <% end %>
              </li>
            <% end %>
          </ul>

          <div class="flex justify-center items-center mt-5">
            <%= paginate @catalog_items, param_name: :catalog_items_page %>
          </div>
        <% else %>
          <p class="text-center my-10">Aucun élément trouvé.</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
