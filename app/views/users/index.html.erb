<% content_for :title, "Adhérents" %>

<div class="flex flex-col sm:flex-row justify-between items-center">
  <%= link_to new_user_path, class: "w-full sm:w-auto mb-5 sm:mb-0 sm:order-2 rounded-md pl-9 pr-4 py-2.5 relative inline-block bg-[#8eb200] hover:bg-[#d93] text-white text-base font-medium text-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-plus pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-white"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
    Nouvel adhérent
  <% end %>
  <h1 class="font-bold text-3xl sm:order-1">Adhérents</h1>
</div>

<div id="users" class="min-w-full divide-y divide-gray-200 space-y-3 mt-5">
  <% if @users.any? %>
    <% @users.each do |user| %>
      <div id="<%= dom_id user %>" class="flex flex-col sm:flex-row justify-between items-start sm:items-center pt-3 sm:pt-0 gap-2">
        <div>
          <p class="font-semibold"><%= user.display_name %></p>
          <p class="text-sm text-gray-500"><%= user.email %> &middot; <%= role_label(user.role) %></p>
        </div>
        <div class="flex items-center -space-x-1">
          <%= edit_icon_button(edit_user_path(user)) %>
          <% if user != current_user %>
            <%= destroy_icon_button(user) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex justify-center items-center mb-10 pt-5">
      <%= paginate @users, param_name: :users_page %>
    </div>
  <% else %>
    <p class="text-center my-10">Aucun adhérent trouvé.</p>
  <% end %>
</div>
